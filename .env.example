# Copy to .env and fill in your own values. .env is gitignored and must never be committed.
# Every value below is a placeholder. Nothing here is a real credential.
#
# This file lists exactly the variables the code reads. Nothing here is decorative: if you
# delete a line, the setting it controls falls back to the default in app/config.py.

# --- Model provider (only needed for a live run; SAMPLE_MODE=true needs none) ---
# Select rules, openai-compatible or meterless. Sample mode overrides remote selection.
LLM_PROVIDER=openai-compatible
# Optional Nightshift local runtime, installed/prewarmed separately; no cloud relay.
#METERLESS_BASE_URL=http://127.0.0.1:8088/v1
#METERLESS_TOKEN=
#METERLESS_MODEL=meterless/local
LLM_BASE_URL=https://api.example-provider.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_MODEL_STRONG=replace-me

# --- OCI (only needed for a live run; never commit real values) ---
# The adapters read these; docs/lab-tenancy.md is the checklist for the tenancy itself.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=ap-batam-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-me

# --- Run behaviour ---
SAMPLE_MODE=true
LOGS_DIR=logs

# --- Zetaris policy source (opt-in; leave unset for the default file-backed policy) ---
# Select "zetaris" only for a live run against a deployed instance; sample mode ignores it.
#DRIFTWATCH_POLICY_SOURCE=file
# Loopback address of an SSH tunnel to the instance; the token is a dedicated READ-ONLY
# runtime principal, never the administrator account. Values below are placeholders only.
#ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
#ZETARIS_API_KEY=
#ZETARIS_ORG_ID=
#ZETARIS_POLICY_OBJECT=<schema.policy_rules_table>
#ZETARIS_MANIFEST_OBJECT=<schema.policy_manifest_table>
#ZETARIS_POLICY_SNAPSHOT=<immutable snapshot id published by scripts/export_zetaris_policy.py>
#ZETARIS_POLICY_SHA256=<64-hex digest pinned at publication>
