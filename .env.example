# Copy to .env and fill in your own values. NEVER commit the real .env.
#
# Rule from the event: credentials load from environment variables only.

# --- Model / inference provider ---
# e.g. OPENAI_API_KEY=, ANTHROPIC_API_KEY=, NVIDIA_API_KEY=
NVIDIA_API_KEY=

# --- Zetaris (data layer) ---
ZETARIS_API_KEY=
ZETARIS_ENDPOINT=

# --- Meterless (orchestration layer) ---
METERLESS_API_KEY=
METERLESS_ENDPOINT=

# --- Agent runtime ---
LOG_LEVEL=INFO
